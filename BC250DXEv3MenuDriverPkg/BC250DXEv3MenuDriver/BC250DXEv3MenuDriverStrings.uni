#string STR_SAFEPOINT_14_TITLE           #language en-US "Freq Volt 14"
#string STR_SAFEPOINT_15_TITLE           #language en-US "Freq Volt 15"
#string STR_SUBTITLE_GPU_CU_TEXT         #language en-US "GPU Compute Units"
#string STR_GPU_CU_PROMPT                #language en-US "Compute Unlock"
#string STR_GPU_CU_HELP                  #language en-US "Factory restores the captured factory CU configuration. Unlock All enables every WGP (40 CU). Custom uses the WGP selection in Individual WGPs. Requires SMU Unlock."
#string STR_GPU_CU_FACTORY               #language en-US "Factory"
#string STR_GPU_CU_ALL                   #language en-US "Unlock All"
#string STR_GPU_CU_CUSTOM                #language en-US "Custom"
#string STR_CU_GOTO_PROMPT               #language en-US "Individual WGPs"
#string STR_CU_GOTO_HELP                 #language en-US "Select the individual WGP (each WGP = two CUs). Only available in Custom mode."
#string STR_SUBMENU_WGP_TITLE            #language en-US "Individual WGPs"
#string STR_WGP_INTRO                    #language en-US "Select the active WGPs. Each WGP supplies two CUs. Custom requires at least one WGP in every bank."
