#langdef en-US "English"

#string STR_FORM_TITLE               #language en-US "MeiMeiDXEv3 Menu"
#string STR_FORM_HELP                #language en-US "Options for the MeiMeiDXEv3 drivers, including ACPI patching, SMU and Core Unlocks, and custom core selection."

#string STR_EMPTY                    #language en-US ""

#string STR_SUBTITLE_PATCH_TEXT      #language en-US "Patch Options"
#string STR_SUBTITLE_SMU_TEXT        #language en-US "SMU Options"
#string STR_SUBTITLE_CORE_TEXT       #language en-US "Core Options"

#string STR_ACPI_PATCH_PROMPT        #language en-US "ACPI Patch"
#string STR_ACPI_PATCH_HELP          #language en-US "Enable the ACPI patch."

#string STR_SMU_UNLOCK_PROMPT        #language en-US "SMU Unlock"
#string STR_SMU_UNLOCK_HELP          #language en-US "Required for all options below."

#string STR_SMU_REPORTING_PATCH_PROMPT #language en-US "SMU Reporting Patch"
#string STR_SMU_REPORTING_PATCH_HELP   #language en-US "Patches SMU for 8 Core Reporting"

#string STR_CORE_UNLOCK_PROMPT       #language en-US "Core Unlock"
#string STR_CORE_UNLOCK_HELP         #language en-US "Disabled - Disable the core unlock and use the factory core mask. Enabled - Enable the unlock for all cores. Custom = Enable using cores set in Individual Core Options."

#string STR_CORE_UNLOCK_DISABLED     #language en-US "Disabled"
#string STR_CORE_UNLOCK_ALL_CORES    #language en-US "All Cores"
#string STR_CORE_UNLOCK_CUSTOM       #language en-US "Custom"

#string STR_CORES_GOTO_PROMPT        #language en-US "Individual Core Options"
#string STR_CORES_GOTO_HELP          #language en-US "Enable or disable individual cores. Only available in Custom mode."
#string STR_SUBTITLE_CCX0_TEXT       #language en-US "CCX0"
#string STR_SUBTITLE_CCX1_TEXT       #language en-US "CCX1"

#string STR_SUBMENU_CORES_TITLE      #language en-US "Individual Cores"

#string STR_CORE0_PROMPT             #language en-US "Core 0"
#string STR_CORE0_HELP               #language en-US "Enable Core 0 (CCX0: Cores 0-3). CCX0 must keep at least one core enabled, and CCX1 must have the same number of cores enabled as CCX0 or be empty."

#string STR_CORE1_PROMPT             #language en-US "Core 1"
#string STR_CORE1_HELP               #language en-US "Enable Core 1 (CCX0: Cores 0-3). CCX0 must keep at least one core enabled, and CCX1 must have the same number of cores enabled as CCX0 or be empty."

#string STR_CORE2_PROMPT             #language en-US "Core 2"
#string STR_CORE2_HELP               #language en-US "Enable Core 2 (CCX0: Cores 0-3). CCX0 must keep at least one core enabled, and CCX1 must have the same number of cores enabled as CCX0 or be empty."

#string STR_CORE3_PROMPT             #language en-US "Core 3"
#string STR_CORE3_HELP               #language en-US "Enable Core 3 (CCX0: Cores 0-3). CCX0 must keep at least one core enabled, and CCX1 must have the same number of cores enabled as CCX0 or be empty."

#string STR_CORE4_PROMPT             #language en-US "Core 4"
#string STR_CORE4_HELP               #language en-US "Enable Core 4 (CCX1: Cores 4-7). CCX1 must have the same number of cores enabled as CCX0 or be empty, and CCX0 must keep at least one core enabled."

#string STR_CORE5_PROMPT             #language en-US "Core 5"
#string STR_CORE5_HELP               #language en-US "Enable Core 5 (CCX1: Cores 4-7). CCX1 must have the same number of cores enabled as CCX0 or be empty, and CCX0 must keep at least one core enabled."

#string STR_CORE6_PROMPT             #language en-US "Core 6"
#string STR_CORE6_HELP               #language en-US "Enable Core 6 (CCX1: Cores 4-7). CCX1 must have the same number of cores enabled as CCX0 or be empty, and CCX0 must keep at least one core enabled."

#string STR_CORE7_PROMPT             #language en-US "Core 7"
#string STR_CORE7_HELP               #language en-US "Enable Core 7 (CCX1: Cores 4-7). CCX1 must have the same number of cores enabled as CCX0 or be empty, and CCX0 must keep at least one core enabled."

#string STR_VALIDATE_CORES_PROMPT        #language en-US "Validate Core Configuration"
#string STR_VALIDATE_CORES_HELP          #language en-US "Check the selected cores against the CCX0/CCX1 rules used by the core unlock driver: CCX0 must keep at least one core enabled, and CCX1 must have the same number of cores enabled as CCX0 or be empty."

#string STR_VALIDATE_PASS_TEXT           #language en-US "PASS - The core configuration is valid."

#string STR_VALIDATE_FAIL_TEXT           #language en-US "FAIL - The core configuration is invalid.\nCCX0 must keep at least one core enabled, and CCX1 must have the same number of cores enabled as CCX0 or be empty.\n\nSelect Yes to reset to the factory core mask, or No to return to the BIOS."

#string STR_VALIDATE_NO_PROTOCOL_TEXT    #language en-US "The core unlock driver is not available, so the core selection cannot be reset to the factory core mask."

#string STR_VALIDATE_NO_FACTORY_MASK_TEXT #language en-US "The factory core mask has not been learned yet (one-time cold boot pending); the core selection was not changed."

#string STR_RESTORE_FACTORY_PROMPT       #language en-US "Restore Factory Core Mask"
#string STR_RESTORE_FACTORY_HELP         #language en-US "Reset the selected cores to the learned factory core mask."
#string STR_RESTORE_FACTORY_CONFIRM_TEXT #language en-US "Restore the core selection to the factory core mask?\nThis replaces the currently selected cores.\n\nSelect Yes to restore, or No to cancel."