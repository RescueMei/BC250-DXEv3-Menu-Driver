#string STR_SAFEPOINT_9_TITLE            #language en-US "Freq Volt 9"
#string STR_SAFEPOINT_10_TITLE           #language en-US "Freq Volt 10"
#string STR_SAFEPOINT_11_TITLE           #language en-US "Freq Volt 11"
#string STR_SAFEPOINT_12_TITLE           #language en-US "Freq Volt 12"
