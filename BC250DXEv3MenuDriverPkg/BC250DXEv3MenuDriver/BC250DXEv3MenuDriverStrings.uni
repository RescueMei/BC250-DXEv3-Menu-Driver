#string STR_SAFEPOINT_5_TITLE            #language en-US "Freq Volt 5"
#string STR_SAFEPOINT_6_TITLE            #language en-US "Freq Volt 6"
#string STR_SAFEPOINT_7_TITLE            #language en-US "Freq Volt 7"
