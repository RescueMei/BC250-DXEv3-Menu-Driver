    // Live CU configuration status: every bank must keep at least one WGP
    // selected, matching the CU driver's CustomConfigValid rule.
      suppressif NOT (((questionref(WGP0_QUESTION_ID) + questionref(WGP1_QUESTION_ID) + questionref(WGP2_QUESTION_ID) + questionref(WGP3_QUESTION_ID) + questionref(WGP4_QUESTION_ID)) >= 1)
                   AND ((questionref(WGP5_QUESTION_ID) + questionref(WGP6_QUESTION_ID) + questionref(WGP7_QUESTION_ID) + questionref(WGP8_QUESTION_ID) + questionref(WGP9_QUESTION_ID)) >= 1)
                   AND ((questionref(WGP10_QUESTION_ID) + questionref(WGP11_QUESTION_ID) + questionref(WGP12_QUESTION_ID) + questionref(WGP13_QUESTION_ID) + questionref(WGP14_QUESTION_ID)) >= 1)
                   AND ((questionref(WGP15_QUESTION_ID) + questionref(WGP16_QUESTION_ID) + questionref(WGP17_QUESTION_ID) + questionref(WGP18_QUESTION_ID) + questionref(WGP19_QUESTION_ID)) >= 1));
        subtitle
          text  = STRING_TOKEN(STR_CU_VALID_TITLE),
          flags = 0,
        endsubtitle;
      endif;

      suppressif (((questionref(WGP0_QUESTION_ID) + questionref(WGP1_QUESTION_ID) + questionref(WGP2_QUESTION_ID) + questionref(WGP3_QUESTION_ID) + questionref(WGP4_QUESTION_ID)) >= 1)
               AND ((questionref(WGP5_QUESTION_ID) + questionref(WGP6_QUESTION_ID) + questionref(WGP7_QUESTION_ID) + questionref(WGP8_QUESTION_ID) + questionref(WGP9_QUESTION_ID)) >= 1)
               AND ((questionref(WGP10_QUESTION_ID) + questionref(WGP11_QUESTION_ID) + questionref(WGP12_QUESTION_ID) + questionref(WGP13_QUESTION_ID) + questionref(WGP14_QUESTION_ID)) >= 1)
               AND ((questionref(WGP15_QUESTION_ID) + questionref(WGP16_QUESTION_ID) + questionref(WGP17_QUESTION_ID) + questionref(WGP18_QUESTION_ID) + questionref(WGP19_QUESTION_ID)) >= 1));
        subtitle
          text  = STRING_TOKEN(STR_CU_INVALID_TITLE),
          flags = 0,
        endsubtitle;

        text
          help = STRING_TOKEN(STR_EMPTY),
          text = STRING_TOKEN(STR_CU_INVALID_TEXT);
      endif;

      text
        help = STRING_TOKEN(STR_EMPTY),
        text = STRING_TOKEN(STR_EMPTY);

    // Restore factory CU mask action (a button, not a stored setting)
      action
