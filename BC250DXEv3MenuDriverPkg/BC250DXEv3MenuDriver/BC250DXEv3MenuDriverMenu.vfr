#include <Uefi/UefiMultiPhase.h>
#include "BC250DXEv3MenuDriver.h"

#define MENU_FORMSET_GUID  { 0xB38377E3, 0x42C0, 0x4A6F, { 0x94, 0xE8, 0x4B, 0xDF, 0x62, 0x35, 0x9F, 0xC9 } }
#define MENU_CONFIG_GUID   { 0x49CC168D, 0xE8B0, 0x4613, { 0xA8, 0x07, 0x16, 0x96, 0x99, 0x86, 0x72, 0x6F } }

formset
  guid      = MENU_FORMSET_GUID,
  title     = STRING_TOKEN(STR_FORM_TITLE),
  help      = STRING_TOKEN(STR_FORM_HELP),
  classguid = { 0x93039971, 0x8545, 0x4b04, { 0xb4, 0x5e, 0x32, 0xeb, 0x83, 0x26, 0x04, 0x0e } },
  class     = 4,
  subclass  = 0,

  efivarstore ACPI_CONFIG,
    attribute = EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS | EFI_VARIABLE_NON_VOLATILE,
    name      = MeiMeiDXEv3AcpiVar,
    guid      = MENU_CONFIG_GUID;

  efivarstore SMU_UNLOCK_CONFIG,
    attribute = EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS | EFI_VARIABLE_NON_VOLATILE,
    name      = MeiMeiDXEv3SmuUnlockVar,
    guid      = MENU_CONFIG_GUID;

  efivarstore SMU_PATCH_CONFIG,
    attribute = EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS | EFI_VARIABLE_NON_VOLATILE,
    name      = MeiMeiDXEv3SmuPatchVar,
    guid      = MENU_CONFIG_GUID;

  efivarstore CORE_CONFIG,
    attribute = EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS | EFI_VARIABLE_NON_VOLATILE,
    name      = MeiMeiDXEv3CoreVar,
    guid      = MENU_CONFIG_GUID;

  form formid = 1,
    title = STRING_TOKEN(STR_FORM_TITLE);

    // Patch options
      subtitle
      text         = STRING_TOKEN(STR_SUBTITLE_PATCH_TEXT),
      flags        = 0,
    endsubtitle;

      text
        help = STRING_TOKEN(STR_EMPTY),
        text = STRING_TOKEN(STR_EMPTY);

      checkbox varid = MeiMeiDXEv3AcpiVar.AcpiPatch,
        prompt       = STRING_TOKEN(STR_ACPI_PATCH_PROMPT),
        help         = STRING_TOKEN(STR_ACPI_PATCH_HELP),
        flags        = RESET_REQUIRED,
      endcheckbox;

    // SMU options
      subtitle
      text         = STRING_TOKEN(STR_SUBTITLE_SMU_TEXT),
      flags        = 0,
    endsubtitle;

      text
        help = STRING_TOKEN(STR_EMPTY),
        text = STRING_TOKEN(STR_EMPTY);

      checkbox varid = MeiMeiDXEv3SmuUnlockVar.SmuUnlock,
        prompt       = STRING_TOKEN(STR_SMU_UNLOCK_PROMPT),
        help         = STRING_TOKEN(STR_SMU_UNLOCK_HELP),
        flags        = RESET_REQUIRED,
      endcheckbox;

      grayoutif NOT ideqval MeiMeiDXEv3SmuUnlockVar.SmuUnlock == 1;
        checkbox varid = MeiMeiDXEv3SmuPatchVar.SmuReportingPatch,
          prompt       = STRING_TOKEN(STR_SMU_REPORTING_PATCH_PROMPT),
          help         = STRING_TOKEN(STR_SMU_REPORTING_PATCH_HELP),
          flags        = RESET_REQUIRED,
        endcheckbox;
      endif;

    // Core options
      subtitle
      text         = STRING_TOKEN(STR_SUBTITLE_CORE_TEXT),
      flags        = 0,
    endsubtitle;

      text
        help = STRING_TOKEN(STR_EMPTY),
        text = STRING_TOKEN(STR_EMPTY);

      grayoutif NOT ideqval MeiMeiDXEv3SmuUnlockVar.SmuUnlock == 1;
        oneof varid = MeiMeiDXEv3CoreVar.CoreUnlock,
          prompt       = STRING_TOKEN(STR_CORE_UNLOCK_PROMPT),
          help         = STRING_TOKEN(STR_CORE_UNLOCK_HELP),
          flags        = RESET_REQUIRED,
          option text = STRING_TOKEN(STR_CORE_UNLOCK_DISABLED),  value = CORE_UNLOCK_DISABLED,  flags = 0;
          option text = STRING_TOKEN(STR_CORE_UNLOCK_ALL_CORES), value = CORE_UNLOCK_ALL_CORES, flags = 0;
          option text = STRING_TOKEN(STR_CORE_UNLOCK_CUSTOM),   value = CORE_UNLOCK_CUSTOM,   flags = 0;
        endoneof;
      endif;

    // Individual core toggles submenu (only enabled in Custom mode)
      grayoutif NOT ideqval MeiMeiDXEv3CoreVar.CoreUnlock == CORE_UNLOCK_CUSTOM;
        goto 2,
          prompt = STRING_TOKEN(STR_CORES_GOTO_PROMPT),
          help   = STRING_TOKEN(STR_CORES_GOTO_HELP);
      endif;

  endform;

  // Submenu: Individual core toggles
  form formid = 2,
    title = STRING_TOKEN(STR_SUBMENU_CORES_TITLE);

    // CCX0: Cores 0-3
      subtitle
      text         = STRING_TOKEN(STR_SUBTITLE_CCX0_TEXT),
      flags        = 0,
    endsubtitle;

      text
        help = STRING_TOKEN(STR_EMPTY),
        text = STRING_TOKEN(STR_EMPTY);

      checkbox varid = MeiMeiDXEv3CoreVar.Core0,
        questionid   = CORE0_QUESTION_ID,
        prompt       = STRING_TOKEN(STR_CORE0_PROMPT),
        help         = STRING_TOKEN(STR_CORE0_HELP),
        flags        = RESET_REQUIRED,
      endcheckbox;

      checkbox varid = MeiMeiDXEv3CoreVar.Core1,
        questionid   = CORE1_QUESTION_ID,
        prompt       = STRING_TOKEN(STR_CORE1_PROMPT),
        help         = STRING_TOKEN(STR_CORE1_HELP),
        flags        = RESET_REQUIRED,
      endcheckbox;

      checkbox varid = MeiMeiDXEv3CoreVar.Core2,
        questionid   = CORE2_QUESTION_ID,
        prompt       = STRING_TOKEN(STR_CORE2_PROMPT),
        help         = STRING_TOKEN(STR_CORE2_HELP),
        flags        = RESET_REQUIRED,
      endcheckbox;

      checkbox varid = MeiMeiDXEv3CoreVar.Core3,
        questionid   = CORE3_QUESTION_ID,
        prompt       = STRING_TOKEN(STR_CORE3_PROMPT),
        help         = STRING_TOKEN(STR_CORE3_HELP),
        flags        = RESET_REQUIRED,
      endcheckbox;

      text
        help = STRING_TOKEN(STR_EMPTY),
        text = STRING_TOKEN(STR_EMPTY);

    // CCX1: Cores 4-7
      subtitle
      text         = STRING_TOKEN(STR_SUBTITLE_CCX1_TEXT),
      flags        = 0,
    endsubtitle;

      text
        help = STRING_TOKEN(STR_EMPTY),
        text = STRING_TOKEN(STR_EMPTY);

      checkbox varid = MeiMeiDXEv3CoreVar.Core4,
        questionid   = CORE4_QUESTION_ID,
        prompt       = STRING_TOKEN(STR_CORE4_PROMPT),
        help         = STRING_TOKEN(STR_CORE4_HELP),
        flags        = RESET_REQUIRED,
      endcheckbox;

      checkbox varid = MeiMeiDXEv3CoreVar.Core5,
        questionid   = CORE5_QUESTION_ID,
        prompt       = STRING_TOKEN(STR_CORE5_PROMPT),
        help         = STRING_TOKEN(STR_CORE5_HELP),
        flags        = RESET_REQUIRED,
      endcheckbox;

      checkbox varid = MeiMeiDXEv3CoreVar.Core6,
        questionid   = CORE6_QUESTION_ID,
        prompt       = STRING_TOKEN(STR_CORE6_PROMPT),
        help         = STRING_TOKEN(STR_CORE6_HELP),
        flags        = RESET_REQUIRED,
      endcheckbox;

      checkbox varid = MeiMeiDXEv3CoreVar.Core7,
        questionid   = CORE7_QUESTION_ID,
        prompt       = STRING_TOKEN(STR_CORE7_PROMPT),
        help         = STRING_TOKEN(STR_CORE7_HELP),
        flags        = RESET_REQUIRED,
      endcheckbox;

      text
        help = STRING_TOKEN(STR_EMPTY),
        text = STRING_TOKEN(STR_EMPTY);

    // Live core configuration status. These blocks are shown or hidden
    // automatically as the individual core checkboxes are toggled.
      suppressif NOT (((questionref(CORE0_QUESTION_ID) + questionref(CORE1_QUESTION_ID) + questionref(CORE2_QUESTION_ID) + questionref(CORE3_QUESTION_ID)) >= 1)
                   AND (((questionref(CORE4_QUESTION_ID) + questionref(CORE5_QUESTION_ID) + questionref(CORE6_QUESTION_ID) + questionref(CORE7_QUESTION_ID)) == 0)
                     OR ((questionref(CORE4_QUESTION_ID) + questionref(CORE5_QUESTION_ID) + questionref(CORE6_QUESTION_ID) + questionref(CORE7_QUESTION_ID)) ==
                         (questionref(CORE0_QUESTION_ID) + questionref(CORE1_QUESTION_ID) + questionref(CORE2_QUESTION_ID) + questionref(CORE3_QUESTION_ID)))));
        subtitle
          text  = STRING_TOKEN(STR_CORE_VALID_TITLE),
          flags = 0,
        endsubtitle;

        text
          help = STRING_TOKEN(STR_EMPTY),
          text = STRING_TOKEN(STR_CORE_VALID_TEXT);
      endif;

      suppressif (((questionref(CORE0_QUESTION_ID) + questionref(CORE1_QUESTION_ID) + questionref(CORE2_QUESTION_ID) + questionref(CORE3_QUESTION_ID)) >= 1)
               AND (((questionref(CORE4_QUESTION_ID) + questionref(CORE5_QUESTION_ID) + questionref(CORE6_QUESTION_ID) + questionref(CORE7_QUESTION_ID)) == 0)
                 OR ((questionref(CORE4_QUESTION_ID) + questionref(CORE5_QUESTION_ID) + questionref(CORE6_QUESTION_ID) + questionref(CORE7_QUESTION_ID)) ==
                     (questionref(CORE0_QUESTION_ID) + questionref(CORE1_QUESTION_ID) + questionref(CORE2_QUESTION_ID) + questionref(CORE3_QUESTION_ID)))));
        subtitle
          text  = STRING_TOKEN(STR_CORE_INVALID_TITLE),
          flags = 0,
        endsubtitle;

        text
          help = STRING_TOKEN(STR_EMPTY),
          text = STRING_TOKEN(STR_CORE_INVALID_TEXT);
      endif;

      text
        help = STRING_TOKEN(STR_EMPTY),
        text = STRING_TOKEN(STR_EMPTY);

    // Restore factory core mask action (a button, not a stored setting)
      action
        questionid = CORES_RESTORE_FACTORY_QUESTION_ID,
        prompt     = STRING_TOKEN(STR_RESTORE_FACTORY_PROMPT),
        help       = STRING_TOKEN(STR_RESTORE_FACTORY_HELP),
        flags      = INTERACTIVE,
        config     = STRING_TOKEN(STR_EMPTY),
      endaction;

  endform;
endformset;